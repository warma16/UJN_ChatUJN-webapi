  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warma16/UJN_ChatUJN-webapi.git"
  },
  "homepage": "https://github.com/warma16/UJN_ChatUJN-webapi",
  "bugs": {
    "url": "https://github.com/warma16/UJN_ChatUJN-webapi/issues"
  },
  "author": "warma16 <metalstudio@126.com>",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
